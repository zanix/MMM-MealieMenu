{
  "name": "mmm-mealiemenu",
  "version": "1.7.0",
  "description": "A MagicMirror² module that displays your Mealie meal plan for the week.",
  "keywords": [
    "MagicMirror",
    "mealie",
    "recipe",
    "meal plan"
  ],
  "homepage": "https://github.com/zanix/MMM-MealieMenu#readme",
  "bugs": {
    "url": "https://github.com/zanix/MMM-MealieMenu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zanix/MMM-MealieMenu.git"
  },
  "license": "MIT",
  "author": {
    "name": "Joshua Clark",
    "url": "https://github.com/zanix"
  },
  "contributors": [
    {
      "name": "Contributers to zanix/MMM-MealieMenu",
      "url": "https://github.com/zanix/MMM-MealieMenu/graphs/contributors"
    }
  ],
  "main": "MMM-MealieMenu.js",
  "type": "commonjs",
  "scripts": {
    "check-updates": "npx npm-check-updates",
    "lint": "eslint && prettier . --check",
    "lint:fix": "eslint --fix && prettier . --write",
    "prepare": "simple-git-hooks || true",
    "release": "commit-and-tag-version --config ./changelog.config.js",
    "test": "node --test"
  },
  "allowScripts": {
    "simple-git-hooks@2.14.0": true,
    "unrs-resolver@1.12.2": true
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ]
  },
  "devDependencies": {
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "commit-and-tag-version": "^13.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-package-json": "^1.12.0",
    "globals": "^17.13.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "moment": "^2.31.0"
  }
}
